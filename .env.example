# Inkloom Sentinel Cloud & Observability Configuration
# Copy this file to .env and fill in your keys when deploying to production

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google OAuth (Configured inside Supabase Auth Dashboard -> Providers -> Google)
# Client ID and Secret are configured in Supabase console

# Highlight.io Full-Stack Observability
VITE_HIGHLIGHT_PROJECT_ID=your_highlight_project_id

# Vercel AI SDK / OpenAI / Anthropic / Gemini (Optional for direct frontend streaming)
VITE_AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
